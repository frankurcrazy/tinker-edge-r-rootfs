[Unit]
Description=Tinker Edge R: give eth0 the MAC address stored in the board EEPROM
Documentation=file:/usr/local/sbin/tinker-eth-mac
Wants=sys-subsystem-net-devices-eth0.device network-pre.target
After=sys-subsystem-net-devices-eth0.device
Before=network-pre.target systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tinker-eth-mac eth0

[Install]
WantedBy=multi-user.target

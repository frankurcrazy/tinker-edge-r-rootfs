[Unit]
Description=Tinker Edge R first boot: grow rootfs, regenerate host keys and machine-id
# A normal service, after udev and all local mounts: growpart runs "udevadm
# settle".  Ordered before systemd-sysusers.service (which udevd waits for) it
# held udevd back for growpart's 120 s settle timeout, and /boot's device job
# timed out first: the first boot ended in emergency mode.
Before=ssh.service
ConditionPathExists=!/var/lib/tinker-first-boot.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tinker-first-boot
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
